# AegisML Enterprise — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Security ─────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AEGISML_SECRET_KEY=change-me-in-production-use-256bit-key
JWT_ALGORITHM=HS256

# ── Environment ───────────────────────────────────────────────────
AEGISML_ENV=production
# Options: production | staging | development

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://app.aegisml.io,https://dashboard.aegisml.io

# ── Alerting ─────────────────────────────────────────────────────
# Slack incoming webhook URL (leave empty to disable)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Generic webhook for PagerDuty/custom (leave empty to disable)
AEGISML_WEBHOOK_URL=

# ── Server ───────────────────────────────────────────────────────
PORT=8000
WORKERS=4
LOG_LEVEL=info

# ── Storage (future — S3 for PDF storage) ────────────────────────
# AWS_REGION=eu-west-2
# S3_BUCKET=aegisml-reports
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
